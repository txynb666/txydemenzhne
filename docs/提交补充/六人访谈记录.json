        "at": "2026-11-05T11:10:33.150Z",
        "durationMs": 2131,
        "usage": {
          "prompt_tokens": 1327,
          "completion_tokens": 209,
          "total_tokens": 1536
        },
        "attemptCount": 1,
        "selection": {
          "provider": "DeepSeek",
